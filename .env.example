# Copy to .env and load it in your shell before running:
#   cp .env.example .env
#   set -a; source .env; set +a

# ---- Backend (backend/app.py) ----
BB_HOST=0.0.0.0
BB_PORT=5001
# Defaults to backend/battery.db when unset
# BB_DB_PATH=/absolute/path/to/battery.db
BB_DEBUG=0
BB_LOW_BATTERY_THRESHOLD=20
# Seconds between "hourly" status alerts (use 60 only for testing)
BB_HOURLY_SECONDS=3600

# ---- Mac scripts (mac/*.py) ----
BACKEND_URL=http://127.0.0.1:5001
DEVICE_ID=neels-macbook
